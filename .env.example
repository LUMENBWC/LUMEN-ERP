# ---------------------------------------------------------------------------
# Banco de dados (Supabase Postgres)
# ---------------------------------------------------------------------------
# ⚠️  NUNCA commite valores reais neste arquivo. Use .env.local (git-ignored).
#
# Connection string via pooler (Supavisor, modo SESSION - nao transaction).
# A API e um processo persistente (nao serverless/edge), entao session mode e o
# indicado (suporta prepared statements e GUCs de sessao corretamente; transaction
# mode nao garante isso e quebrava o set_config usado pelo RLS - ver ADR-0002).
# Papel `app_api`: NAO tem BYPASSRLS, entao RLS e realmente aplicada (defesa em profundidade).
# Ver migration 20260803005036_roles_rls_auth_fk para criar o papel.
#
# Formato: postgresql://usuario:senha@host:port/database
# NUNCA coloque a senha aqui - use variavel de ambiente ou secret manager
DATABASE_URL="postgresql://app_api.[PROJECT-REF]:[APP_API_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Connection direta (via pooler Supavisor em modo session - a conexao direta real
# e IPv6-only e pode nao resolver em redes sem IPv6) - usada apenas pelo Prisma Migrate (DDL).
# Papel `prisma_migrator`: BYPASSRLS + CREATEDB, dedicado a migrations (nao usar em runtime).
# ⚠️  Esta chave deve ter permissões LIMITADAS - apenas para migrations
DIRECT_URL="postgresql://prisma_migrator.[PROJECT-REF]:[PRISMA_MIGRATOR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase (Auth + Storage)
# ---------------------------------------------------------------------------
SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# JWKS publico do projeto (chaves assimetricas ES256) - usado por @supabase/server
# para verificar o JWT sem precisar de nenhum segredo.
# Esta URL e publica e pode ser divulgada livremente
SUPABASE_JWKS_URL="https://[PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json"

SUPABASE_PUBLISHABLE_KEY=""

# ⚠️  CHAVE SECRETA - NUNCA exponha em public (client-side)
# Usada por createAdminClient() no Supabase Storage para gerar e assinar os PDFs
# Nao e usada na verificacao de JWT (essa usa so o JWKS publico).
# - Em desenvolvimento: use .env.local com credenciais de teste
# - Em producao: injete via secret manager (AWS Secrets, Google Secret Manager, etc)
# - NUNCA commit neste arquivo
SUPABASE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV="development"
# Origens permitidas para CORS, separadas por virgula (sem barra final).
# OBRIGATORIA quando NODE_ENV=production - a API se recusa a subir sem ela,
# em vez de aceitar qualquer origem. Em dev, se vazia, reflete a origem da
# requisicao.
#   ex. producao: CORS_ORIGINS="https://app.seudominio.com.br"
CORS_ORIGINS=""
# O Swagger (/api/v1/docs) fica desligado quando NODE_ENV=production, porque
# publica o mapa completo de rotas e permissoes. Defina como "true" apenas se
# precisar depurar um ambiente publicado.
# ENABLE_SWAGGER="false"
# Tamanho maximo dos dois pools `pg`. O Supavisor em modo SESSION limita o
# numero de clientes do PROJETO INTEIRO (`pool_size`, tipicamente 15 no plano
# free) - somando todas as replicas da API, Prisma Studio, migrations e e2e.
# Regra: (DB_POOL_MAX + DB_AUTH_POOL_MAX) x replicas << pool_size do projeto.
# Estourar isso da `(EMAXCONNSESSION) max clients reached in session mode`.
DB_POOL_MAX=8
DB_AUTH_POOL_MAX=2
# Opcional - usado só por `prisma db seed`. UUID de um usuário já existente no
# Supabase Auth; se definido, o seed cria o usuário administrador demo vinculado a ele.
# SEED_ADMIN_AUTH_USER_ID=

# ---------------------------------------------------------------------------
# Web (apps/web) - variáveis públicas expostas ao browser
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# ---------------------------------------------------------------------------
# Integrações futuras (placeholders - sem credenciais reais)
# ---------------------------------------------------------------------------
# BANCO_INTER_CLIENT_ID=
# BANCO_INTER_CLIENT_SECRET=
# ASAAS_API_KEY=
# MERCADO_PAGO_ACCESS_TOKEN=
# STONE_API_KEY=
# WHATSAPP_BUSINESS_TOKEN=
# CORREIOS_API_KEY=
# MELHOR_ENVIO_TOKEN=

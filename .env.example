# ---------------------------------------------------------------------------
# Banco de dados (Supabase Postgres)
# ---------------------------------------------------------------------------
# Connection string via pooler (pgbouncer) - usar na aplicação (apps/api)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Connection string direta - usar apenas para migrations (Prisma Migrate)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase (Auth + Storage)
# ---------------------------------------------------------------------------
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Web (apps/web) - variáveis públicas expostas ao browser
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# ---------------------------------------------------------------------------
# Integrações futuras (placeholders - sem credenciais reais)
# ---------------------------------------------------------------------------
# BANCO_INTER_CLIENT_ID=
# BANCO_INTER_CLIENT_SECRET=
# ASAAS_API_KEY=
# MERCADO_PAGO_ACCESS_TOKEN=
# STONE_API_KEY=

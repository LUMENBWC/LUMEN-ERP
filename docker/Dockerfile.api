FROM node:22-slim AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/config/package.json packages/config/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/api/prisma.config.ts apps/api/prisma.config.ts
COPY apps/api/prisma apps/api/prisma
RUN pnpm install --frozen-lockfile --filter @erp/api...

FROM base AS build
COPY --from=deps /app /app
COPY packages/config packages/config
COPY apps/api apps/api
RUN pnpm --filter @erp/api run build

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=deps /app/node_modules /app/node_modules
COPY --from=deps /app/apps/api/node_modules /app/apps/api/node_modules
COPY --from=build /app/apps/api/dist /app/apps/api/dist
COPY --from=build /app/apps/api/package.json /app/apps/api/package.json

WORKDIR /app/apps/api
EXPOSE 3001

# `/api/v1/health` é @Public() (não exige JWT), então serve como probe.
# Usado pelo Coolify/compose para saber se o container está realmente servindo,
# e não apenas "de pé".
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \n  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/src/main.js"]

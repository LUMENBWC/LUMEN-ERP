# ⚠️ TEMPLATE .env PRODUÇÃO
# Copie este arquivo, preencha os valores reais e defina as variáveis no Render/Vercel
# NUNCA commite valores reais no git!

# ============================================================================
# BANCO DE DADOS - Supabase Produção
# ============================================================================

# Role: app_api (SEM BYPASSRLS - defesa em profundidade)
# Obtém no SQL Editor do Supabase: 
#   SELECT connection_string FROM postgres_roles WHERE name = 'app_api'
DATABASE_URL="postgresql://app_api.XXXXXX:[SENHA_APP_API_FORTE]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Role: prisma_migrator (BYPASSRLS, apenas migrations)
# Obtém no SQL Editor do Supabase após rodar scripts/01-bootstrap-roles.sql
DIRECT_URL="postgresql://prisma_migrator.XXXXXX:[SENHA_PRISMA_MIGRATOR_FORTE]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ============================================================================
# Supabase Auth & Storage
# ============================================================================

# Obtém em: Project Settings → API
SUPABASE_URL="https://XXXXXX.supabase.co"
SUPABASE_JWKS_URL="https://XXXXXX.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_PUBLISHABLE_KEY="eyJhbGci..."

# ⚠️ CRÍTICO: Necessário para gerar PDFs de orçamento
# Obtém em: Project Settings → API → Service Role Secret
# MARCAR COMO SECRET no Render
SUPABASE_SECRET_KEY="eyJhbGci..."

# ============================================================================
# API Configuração
# ============================================================================

# Domínio do frontend - OBRIGATÓRIO em produção
# A API NÃO sobe se vazio
CORS_ORIGINS="https://lumenerp.vercel.app"

NODE_ENV="production"
PORT="3001"

# Pool de conexões (ajustar conforme carga)
# Default: 8 + 2 = 10 conexões por réplica
# Máx no free tier Supabase: ~15 total
DB_POOL_MAX="8"
DB_AUTH_POOL_MAX="2"

# Swagger desligado em produção (não publica mapa de rotas)
ENABLE_SWAGGER="false"

# ============================================================================
# Frontend - Vercel (variáveis NEXT_PUBLIC_)
# ============================================================================
# 
# Defina no painel do Vercel, não aqui:
#
# NEXT_PUBLIC_SUPABASE_URL=https://XXXXXX.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGci...
# NEXT_PUBLIC_API_URL=https://lumen-erp.onrender.com/api/v1
#

# ============================================================================
# INSTRUÇÕES DE PREENCHIMENTO
# ============================================================================
#
# 1. Abrir projeto Supabase PRODUÇÃO (https://app.supabase.com)
#
# 2. Project Settings → API:
#    - SUPABASE_URL: copiar "URL"
#    - SUPABASE_JWKS_URL: construir como em cima
#    - SUPABASE_PUBLISHABLE_KEY: copiar "anon public"
#    - SUPABASE_SECRET_KEY: copiar "service_role secret"
#
# 3. Rodar scripts/01-bootstrap-roles.sql no SQL Editor:
#    - Substituir TROQUE_POR_UMA_SENHA_FORTE_APP_API
#    - Substituir TROQUE_POR_UMA_SENHA_FORTE_PRISMA
#    - DATABASE_URL e DIRECT_URL obtêm daqui
#
# 4. Ir para Render dashboard:
#    - Settings → Environment
#    - Adicionar cada variável
#    - Marcar DATABASE_URL, DIRECT_URL e SUPABASE_SECRET_KEY como "Secret"
#
# 5. Ir para Vercel dashboard:
#    - Settings → Environment Variables
#    - Adicionar as NEXT_PUBLIC_*
#
# ============================================================================

